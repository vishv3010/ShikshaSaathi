# Copy this file to .env (git ignores .env) and fill in the key.
# Without a key the assistant runs on rules only; every answer is still correct.

# Free key: https://aistudio.google.com -> "Get API key"
GEMINI_API_KEY=

# Optional
# GEMINI_MODEL=gemini-3.5-flash-lite
# SAATHI_LLM=off        # force rules only
